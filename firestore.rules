rules_version = '2';

// ===============================================================
// Assumed Data Model (SmartGym OS - Multi-Tenant SaaS)
// ===============================================================
//
// Collection: phone_index/{phone}
// Document ID: Normalized E.164 phone number (e.g. "+919849012345")
// Fields:
//   - phone: string (optional, 7..20 chars, matches doc ID if present)
//   - role: string (required, "owner" | "trainer" | "member")
//   - gymId: string (required, 1..64 chars, immutable on update)
//   - uid: string (required, 0..128 chars)
//   - name: string (required, 0..100 chars)
//   - inviteCode: string (optional, 4..64 chars)
//   - updatedAt: timestamp (optional)
//
// Collection: pending_requests/{phone}
// Document ID: Normalized E.164 phone number (e.g. "+919849012345")
// Fields:
//   - phone: string (required, 7..20 chars, == doc ID)
//   - gymId: string (required, 1..64 chars)
//   - gymName: string (required, 1..100 chars)
//   - uid: string (required, 1..128 chars)
//   - updatedAt: timestamp (optional)
//
// Collection: gyms/{gymId}
// Document ID: Gym tenant ID
// Fields:
//   - id: string (optional, 1..64 chars, immutable)
//   - name: string (required, 1..100 chars)
//   - area: string (required, 1..100 chars)
//   - headTrainer: string (required, 1..100 chars)
//   - monthlyFee: number (required, >= 0, <= 1000000)
//   - ptFee: number (required, >= 0, <= 1000000)
//   - feePlans: list (optional, <= 25 membership/custom plan maps)
//   - activeCrowd: int (required, >= 0, <= maxCapacity)
//   - crowdDate: string (optional, "" or "YYYY-MM-DD" format, <= 10 chars)
//   - hourlyCheckIns: list (optional, 24-element int list, each >= 0, <= 1000000)
//   - maxCapacity: int (required, >= 1, <= 10000)
//   - latitude: number (optional, >= -90, <= 90)
//   - longitude: number (optional, >= -180, <= 180)
//   - checkInRadiusMeters: int (optional, >= 20, <= 1000)
//   - requireGpsCheckIn: bool (optional)
//   - ptSplitExcludesBaseFee: bool (optional)
//   - ownerUid: string (required, 1..128 chars, immutable)
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//
// Collection: gyms/{gymId}/trainers/{trainerId}
// Fields:
//   - id: string (optional, 1..64 chars, immutable)
//   - name: string (required, 1..100 chars)
//   - phone: string (optional, 7..20 chars)
//   - specialty: string (required, 1..100 chars)
//   - morningCheckInTime: string (required, 0..30 chars)
//   - isOnDuty: bool (required)
//   - commissionPercent: number (required, >= 0, <= 100)
//   - inviteCode: string (optional, 4..64 chars)
//   - shiftSlot: string (optional, 0..60 chars)
//
// Collection: gyms/{gymId}/invites/{inviteCode}
// Document ID: Invite code string
// Fields:
//   - code: string (required, 4..64 chars, immutable)
//   - gymId: string (required, 1..64 chars, == gymId, immutable)
//   - gymName: string (optional, 1..100 chars)
//   - active: bool (required)
//   - createdByUid: string (required, 1..128 chars, immutable)
//   - createdAt: timestamp (optional, immutable)
//
// Collection: gyms/{gymId}/trainer_requests/{requestId}
// Fields:
//   - id: string (required, 1..128 chars)
//   - name: string (required, 1..100 chars)
//   - phone: string (required, 7..20 chars)
//   - uid: string (required, 1..128 chars)
//   - inviteCode: string (required, 4..64 chars)
//   - status: string (required, "pending")
//   - createdAt: timestamp (optional)
//
// Collection: gyms/{gymId}/members/{memberId}
// Fields:
//   - id: string (optional, 1..64 chars, immutable)
//   - name: string (required, 1..100 chars)
//   - gender: string (optional, 0..30 chars)
//   - phone: string (required, 7..20 chars)
//   - planTitle: string (required, 1..100 chars)
//   - feePaid: number (required, >= 0, <= 1000000)
//   - dueAmount: number (optional, >= 0, <= 1000000)
//   - joinedDate: string (required, 1..40 chars)
//   - expiryDate: string (required, 1..40 chars)
//   - daysLeft: int (required, -3650..3650)
//   - assignedTrainer: string (required, 0..100 chars)
//   - isPtClient: bool (required)
//   - addedByTrainer: string (required, 0..100 chars)
//   - currentWeightKg: number (required, >= 10, <= 500)
//   - paymentMode: string (optional, "Cash" | "Online")
//   - paymentReference: string (optional, 0..64 chars)
//   - paymentProofBase64: string (optional, 0..150000 chars)
//   - isInFloor: bool (optional)
//   - floorCheckInTime: string (optional, 0..30 chars, e.g. "2026-11-27 • 06:30 AM" or "")
//   - createdAt: timestamp (optional, immutable)
//
// Collection: gyms/{gymId}/enquiries/{enquiryId}
// Fields:
//   - id: string (optional, 1..64 chars, immutable)
//   - name: string (required, 1..100 chars)
//   - phone: string (required, 7..20 chars)
//   - interestedPlan: string (required, 1..100 chars)
//   - loggedByTrainer: string (required, 0..100 chars)
//   - timeLabel: string (required, 1..50 chars)
//   - converted: bool (required)
//   - createdAt: timestamp (optional, immutable)
//
// Collection: gyms/{gymId}/meals/{mealId}
// Fields:
//   - id: string (optional, 1..64 chars, immutable)
//   - memberName: string (required, 1..100 chars)
//   - timeLabel: string (required, 1..50 chars)
//   - mealDescription: string (required, 1..1000 chars)
//   - macros: string (required, 0..200 chars)
//   - trainerFeedback: string (required, 0..500 chars)
//   - memberPhone: string (optional, 7..20 chars, immutable)
//
// Collection: gyms/{gymId}/machines/{machineId}
// Fields:
//   - code: string (required, 1..30 chars, immutable)
//   - name: string (required, 1..100 chars)
//   - muscle: string (required, 1..100 chars)
//   - mistakeTip: string (required, 0..500 chars)
//
// Collection: gyms/{gymId}/missing/{missingId}
// Fields:
//   - name: string (required, 1..100 chars)
//   - daysMissing: int (required, 0..3650)
//   - planName: string (required, 0..100 chars)
//   - lastMuscleTrained: string (required, 0..100 chars)
//   - contacted: bool (required)
//
// Collection: gyms/{gymId}/removed_logs/{logId}
// Fields:
//   - id: string (required, 1..128 chars)
//   - type: string (required, "trainer" | "member")
//   - name: string (required, 1..100 chars)
//   - phone: string (required, 0..20 chars)
//   - details: string (required, 0..200 chars)
//   - removedAt: timestamp (optional)
//
// Collection: gyms/{gymId}/trainer_attendance/{logId}
// Fields:
//   - id: string (required, 1..128 chars)
//   - trainerId: string (required, 1..128 chars)
//   - trainerName: string (required, 1..100 chars)
//   - trainerPhone: string (required, 0..20 chars)
//   - dateKey: string (required, YYYY-MM-DD, 10 chars, validated via isValidCrowdDateString)
//   - timeLabel: string (required, 1..30 chars)
//   - eventType: string (required, "duty_checkin" | "login")
//   - timestampMs: int (required, >= 0, <= 4102444800000)
//   - createdAt: timestamp (optional)
//
// Collection: app_config/{docId}
// Document ID: Config document key (e.g. "ai" for rotating Gemini API keys)
// Access: Read-only for authenticated users; writes denied to clients (Admin SDK / Console only)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function hasPhone() {
      return isAuthenticated() &&
             ('phone_number' in request.auth.token) &&
             request.auth.token.phone_number is string;
    }

    function userPhone() {
      return request.auth.token.phone_number;
    }

    function phoneIndexPath() {
      return /databases/$(database)/documents/phone_index/$(userPhone());
    }

    function hasPhoneIndex() {
      return hasPhone() && exists(phoneIndexPath());
    }

    function phoneIndexData() {
      return get(phoneIndexPath()).data;
    }

    function gymPath(gymId) {
      return /databases/$(database)/documents/gyms/$(gymId);
    }

    function isGymDocOwner(gymId) {
      return isAuthenticated() && (
        (exists(gymPath(gymId)) &&
         'ownerUid' in get(gymPath(gymId)).data &&
         get(gymPath(gymId)).data.ownerUid == request.auth.uid) ||
        (request.method in ['create', 'update', 'delete'] &&
         existsAfter(gymPath(gymId)) &&
         'ownerUid' in getAfter(gymPath(gymId)).data &&
         getAfter(gymPath(gymId)).data.ownerUid == request.auth.uid)
      );
    }

    function isGymOwner(gymId) {
      return isAuthenticated() && (
        ('role' in request.auth.token &&
         'gymId' in request.auth.token &&
         request.auth.token.role == 'owner' &&
         request.auth.token.gymId == gymId) ||
        isGymDocOwner(gymId) ||
        (hasPhoneIndex() &&
         'gymId' in phoneIndexData() &&
         'role' in phoneIndexData() &&
         phoneIndexData().gymId == gymId &&
         phoneIndexData().role == 'owner')
      );
    }

    function isGymTrainer(gymId) {
      return isAuthenticated() && (
        ('role' in request.auth.token &&
         'gymId' in request.auth.token &&
         request.auth.token.role == 'trainer' &&
         request.auth.token.gymId == gymId) ||
        (hasPhoneIndex() &&
         'gymId' in phoneIndexData() &&
         'role' in phoneIndexData() &&
         phoneIndexData().gymId == gymId &&
         phoneIndexData().role == 'trainer')
      );
    }

    function isGymMember(gymId) {
      return isAuthenticated() && (
        ('role' in request.auth.token &&
         'gymId' in request.auth.token &&
         request.auth.token.role == 'member' &&
         request.auth.token.gymId == gymId) ||
        (hasPhoneIndex() &&
         'gymId' in phoneIndexData() &&
         'role' in phoneIndexData() &&
         phoneIndexData().gymId == gymId &&
         phoneIndexData().role == 'member')
      );
    }

    function isStaffOfGym(gymId) {
      return isGymOwner(gymId) || isGymTrainer(gymId);
    }

    function isUserOfGym(gymId) {
      return isGymOwner(gymId) || isGymTrainer(gymId) || isGymMember(gymId);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || isValidString(data[field], minLen, maxLen);
    }

    function isValidOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isValidPhoneString(val) {
      return val is string && val.size() >= 7 && val.size() <= 20;
    }

    function isValidCrowdDateString(val) {
      return val is string &&
             val.size() == 10 &&
             val.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isValidOptionalCrowdDateValue(val) {
      return val is string &&
             val.size() <= 10 &&
             (val == '' || isValidCrowdDateString(val));
    }

    function isValidHourlyCount(val) {
      return val is int && val >= 0 && val <= 1000000;
    }

    function isValidHourlyCheckIns(listData) {
      return listData is list &&
             listData.size() == 24 &&
             isValidHourlyCount(listData[0]) &&
             isValidHourlyCount(listData[1]) &&
             isValidHourlyCount(listData[2]) &&
             isValidHourlyCount(listData[3]) &&
             isValidHourlyCount(listData[4]) &&
             isValidHourlyCount(listData[5]) &&
             isValidHourlyCount(listData[6]) &&
             isValidHourlyCount(listData[7]) &&
             isValidHourlyCount(listData[8]) &&
             isValidHourlyCount(listData[9]) &&
             isValidHourlyCount(listData[10]) &&
             isValidHourlyCount(listData[11]) &&
             isValidHourlyCount(listData[12]) &&
             isValidHourlyCount(listData[13]) &&
             isValidHourlyCount(listData[14]) &&
             isValidHourlyCount(listData[15]) &&
             isValidHourlyCount(listData[16]) &&
             isValidHourlyCount(listData[17]) &&
             isValidHourlyCount(listData[18]) &&
             isValidHourlyCount(listData[19]) &&
             isValidHourlyCount(listData[20]) &&
             isValidHourlyCount(listData[21]) &&
             isValidHourlyCount(listData[22]) &&
             isValidHourlyCount(listData[23]);
    }

    function invitePath(gymId, inviteCode) {
      return /databases/$(database)/documents/gyms/$(gymId)/invites/$(inviteCode);
    }

    function hasActiveInvite(gymId, inviteCode) {
      return isValidString(gymId, 1, 64) &&
             isValidString(inviteCode, 4, 64) &&
             exists(invitePath(gymId, inviteCode)) &&
             'active' in get(invitePath(gymId, inviteCode)).data &&
             get(invitePath(gymId, inviteCode)).data.active == true;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidPhoneIndex(data, phoneDocId) {
      return hasRequiredFields(['role', 'gymId', 'uid', 'name']) &&
             hasOnlyAllowedFields(['phone', 'role', 'gymId', 'uid', 'name', 'inviteCode', 'updatedAt']) &&
             isValidPhoneString(phoneDocId) &&
             (!('phone' in data) || (isValidPhoneString(data.phone) && data.phone == phoneDocId)) &&
             data.role in ['owner', 'trainer', 'member'] &&
             isValidString(data.gymId, 1, 64) &&
             isValidString(data.uid, 0, 128) &&
             isValidString(data.name, 0, 100) &&
             isValidOptionalString(data, 'inviteCode', 4, 64) &&
             isValidOptionalTimestamp(data, 'updatedAt');
    }

    function isValidPendingRequest(data, phoneDocId) {
      return hasRequiredFields(['phone', 'gymId', 'gymName', 'uid']) &&
             hasOnlyAllowedFields(['phone', 'gymId', 'gymName', 'uid', 'updatedAt']) &&
             isValidPhoneString(phoneDocId) &&
             isValidPhoneString(data.phone) &&
             data.phone == phoneDocId &&
             isValidString(data.gymId, 1, 64) &&
             isValidString(data.gymName, 1, 100) &&
             isValidString(data.uid, 1, 128) &&
             isValidOptionalTimestamp(data, 'updatedAt');
    }

    function isValidGym(data) {
      return hasRequiredFields([
               'name', 'area', 'headTrainer', 'monthlyFee',
               'ptFee', 'activeCrowd', 'maxCapacity', 'ownerUid'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'name', 'area', 'headTrainer', 'monthlyFee',
               'ptFee', 'feePlans', 'activeCrowd', 'crowdDate',
               'hourlyCheckIns', 'maxCapacity', 'latitude',
               'longitude', 'checkInRadiusMeters', 'requireGpsCheckIn',
               'ptSplitExcludesBaseFee', 'ownerUid', 'createdAt', 'updatedAt'
             ]) &&
             isValidOptionalString(data, 'id', 1, 64) &&
             isValidString(data.name, 1, 100) &&
             isValidString(data.area, 1, 100) &&
             isValidString(data.headTrainer, 1, 100) &&
             data.monthlyFee is number && data.monthlyFee >= 0 && data.monthlyFee <= 1000000 &&
             data.ptFee is number && data.ptFee >= 0 && data.ptFee <= 1000000 &&
             (!('feePlans' in data) || (data.feePlans is list && data.feePlans.size() <= 25)) &&
             data.maxCapacity is int && data.maxCapacity >= 1 && data.maxCapacity <= 10000 &&
             data.activeCrowd is int && data.activeCrowd >= 0 && data.activeCrowd <= data.maxCapacity &&
             (!('crowdDate' in data) || isValidOptionalCrowdDateValue(data.crowdDate)) &&
             (!('hourlyCheckIns' in data) || isValidHourlyCheckIns(data.hourlyCheckIns)) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             (!('checkInRadiusMeters' in data) || (data.checkInRadiusMeters is int && data.checkInRadiusMeters >= 20 && data.checkInRadiusMeters <= 1000)) &&
             (!('requireGpsCheckIn' in data) || data.requireGpsCheckIn is bool) &&
             (!('ptSplitExcludesBaseFee' in data) || data.ptSplitExcludesBaseFee is bool) &&
             isValidString(data.ownerUid, 1, 128) &&
             isValidOptionalTimestamp(data, 'createdAt') &&
             isValidOptionalTimestamp(data, 'updatedAt');
    }

    function isValidMemberCrowdUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let hasValidNewCrowdDate = ('crowdDate' in request.resource.data) &&
                                 isValidCrowdDateString(request.resource.data.crowdDate);
      let isInitialCrowdDateBootstrap = hasValidNewCrowdDate &&
                                        (!('crowdDate' in resource.data) ||
                                         resource.data.crowdDate == '');
      let isStrictForwardRollover = hasValidNewCrowdDate &&
                                    ('crowdDate' in resource.data) &&
                                    resource.data.crowdDate is string &&
                                    resource.data.crowdDate != '' &&
                                    request.resource.data.crowdDate > resource.data.crowdDate;
      let isDeltaOne = ('activeCrowd' in resource.data) &&
                       resource.data.activeCrowd is int &&
                       math.abs(request.resource.data.activeCrowd - resource.data.activeCrowd) == 1;
      return affected.hasOnly(['activeCrowd', 'crowdDate', 'hourlyCheckIns']) &&
             (!('hourlyCheckIns' in resource.data) || ('hourlyCheckIns' in request.resource.data)) &&
             (
               (isStrictForwardRollover &&
                request.resource.data.activeCrowd == 1) ||
               (isInitialCrowdDateBootstrap &&
                (request.resource.data.activeCrowd == 1 || isDeltaOne)) ||
               (!isStrictForwardRollover &&
                !isInitialCrowdDateBootstrap &&
                !affected.hasAny(['crowdDate']) &&
                isDeltaOne)
             );
    }

    function isValidTrainer(data) {
      return hasRequiredFields([
               'name', 'specialty', 'morningCheckInTime', 'isOnDuty', 'commissionPercent'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'name', 'phone', 'specialty', 'morningCheckInTime',
               'isOnDuty', 'commissionPercent', 'inviteCode', 'shiftSlot'
             ]) &&
             isValidOptionalString(data, 'id', 1, 64) &&
             isValidString(data.name, 1, 100) &&
             (!('phone' in data) || isValidPhoneString(data.phone)) &&
             isValidString(data.specialty, 1, 100) &&
             isValidString(data.morningCheckInTime, 0, 30) &&
             data.isOnDuty is bool &&
             data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 100 &&
             isValidOptionalString(data, 'inviteCode', 4, 64) &&
             isValidOptionalString(data, 'shiftSlot', 0, 60);
    }

    function isValidInvite(data, gymId) {
      return hasRequiredFields(['code', 'gymId', 'active', 'createdByUid']) &&
             hasOnlyAllowedFields(['code', 'gymId', 'gymName', 'active', 'createdByUid', 'createdAt']) &&
             isValidString(data.code, 4, 64) &&
             isValidString(data.gymId, 1, 64) &&
             data.gymId == gymId &&
             isValidOptionalString(data, 'gymName', 1, 100) &&
             data.active is bool &&
             isValidString(data.createdByUid, 1, 128) &&
             isValidOptionalTimestamp(data, 'createdAt');
    }

    function isValidTrainerRequest(data) {
      return hasRequiredFields(['id', 'name', 'phone', 'uid', 'inviteCode', 'status']) &&
             hasOnlyAllowedFields(['id', 'name', 'phone', 'uid', 'inviteCode', 'status', 'createdAt']) &&
             isValidString(data.id, 1, 128) &&
             isValidString(data.name, 1, 100) &&
             isValidPhoneString(data.phone) &&
             isValidString(data.uid, 1, 128) &&
             isValidString(data.inviteCode, 4, 64) &&
             data.status == 'pending' &&
             isValidOptionalTimestamp(data, 'createdAt');
    }

    function isValidMember(data) {
      return hasRequiredFields([
               'name', 'phone', 'planTitle', 'feePaid', 'joinedDate',
               'expiryDate', 'daysLeft', 'assignedTrainer', 'isPtClient',
               'addedByTrainer', 'currentWeightKg'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'name', 'gender', 'phone', 'planTitle', 'feePaid',
               'dueAmount', 'joinedDate', 'expiryDate', 'daysLeft',
               'assignedTrainer', 'isPtClient', 'addedByTrainer',
               'currentWeightKg', 'paymentMode', 'paymentReference',
               'paymentProofBase64', 'isInFloor', 'floorCheckInTime',
               'createdAt'
             ]) &&
             isValidOptionalString(data, 'id', 1, 64) &&
             isValidString(data.name, 1, 100) &&
             isValidOptionalString(data, 'gender', 0, 30) &&
             isValidPhoneString(data.phone) &&
             isValidString(data.planTitle, 1, 100) &&
             data.feePaid is number && data.feePaid >= 0 && data.feePaid <= 1000000 &&
             (!('dueAmount' in data) || (data.dueAmount is number && data.dueAmount >= 0 && data.dueAmount <= 1000000)) &&
             isValidString(data.joinedDate, 1, 40) &&
             isValidString(data.expiryDate, 1, 40) &&
             data.daysLeft is int && data.daysLeft >= -3650 && data.daysLeft <= 3650 &&
             isValidString(data.assignedTrainer, 0, 100) &&
             data.isPtClient is bool &&
             isValidString(data.addedByTrainer, 0, 100) &&
             data.currentWeightKg is number && data.currentWeightKg >= 10 && data.currentWeightKg <= 500 &&
             (!('paymentMode' in data) || (data.paymentMode is string && data.paymentMode in ['Cash', 'Online'])) &&
             isValidOptionalString(data, 'paymentReference', 0, 64) &&
             isValidOptionalString(data, 'paymentProofBase64', 0, 150000) &&
             (!('isInFloor' in data) || data.isInFloor is bool) &&
             isValidOptionalString(data, 'floorCheckInTime', 0, 30) &&
             isValidOptionalTimestamp(data, 'createdAt');
    }

    function isValidEnquiry(data) {
      return hasRequiredFields([
               'name', 'phone', 'interestedPlan', 'loggedByTrainer', 'timeLabel', 'converted'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'name', 'phone', 'interestedPlan', 'loggedByTrainer',
               'timeLabel', 'converted', 'createdAt'
             ]) &&
             isValidOptionalString(data, 'id', 1, 64) &&
             isValidString(data.name, 1, 100) &&
             isValidPhoneString(data.phone) &&
             isValidString(data.interestedPlan, 1, 100) &&
             isValidString(data.loggedByTrainer, 0, 100) &&
             isValidString(data.timeLabel, 1, 50) &&
             data.converted is bool &&
             isValidOptionalTimestamp(data, 'createdAt');
    }

    function isValidMeal(data) {
      return hasRequiredFields([
               'memberName', 'timeLabel', 'mealDescription', 'macros', 'trainerFeedback'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'memberName', 'timeLabel', 'mealDescription',
               'macros', 'trainerFeedback', 'memberPhone'
             ]) &&
             isValidOptionalString(data, 'id', 1, 64) &&
             isValidString(data.memberName, 1, 100) &&
             isValidString(data.timeLabel, 1, 50) &&
             isValidString(data.mealDescription, 1, 1000) &&
             isValidString(data.macros, 0, 200) &&
             isValidString(data.trainerFeedback, 0, 500) &&
             (!('memberPhone' in data) || isValidPhoneString(data.memberPhone));
    }

    function isValidMachine(data) {
      return hasRequiredFields(['code', 'name', 'muscle', 'mistakeTip']) &&
             hasOnlyAllowedFields(['code', 'name', 'muscle', 'mistakeTip']) &&
             isValidString(data.code, 1, 30) &&
             isValidString(data.name, 1, 100) &&
             isValidString(data.muscle, 1, 100) &&
             isValidString(data.mistakeTip, 0, 500);
    }

    function isValidMissingMember(data) {
      return hasRequiredFields(['name', 'daysMissing', 'planName', 'lastMuscleTrained', 'contacted']) &&
             hasOnlyAllowedFields(['name', 'daysMissing', 'planName', 'lastMuscleTrained', 'contacted']) &&
             isValidString(data.name, 1, 100) &&
             data.daysMissing is int && data.daysMissing >= 0 && data.daysMissing <= 3650 &&
             isValidString(data.planName, 0, 100) &&
             isValidString(data.lastMuscleTrained, 0, 100) &&
             data.contacted is bool;
    }

    function isValidRemovedLog(data) {
      return hasRequiredFields(['id', 'type', 'name', 'phone', 'details']) &&
             hasOnlyAllowedFields(['id', 'type', 'name', 'phone', 'details', 'removedAt']) &&
             isValidString(data.id, 1, 128) &&
             data.type in ['trainer', 'member'] &&
             isValidString(data.name, 1, 100) &&
             isValidString(data.phone, 0, 20) &&
             isValidString(data.details, 0, 200) &&
             isValidOptionalTimestamp(data, 'removedAt');
    }

    function isValidTrainerAttendance(data) {
      return hasRequiredFields([
               'id', 'trainerId', 'trainerName', 'trainerPhone',
               'dateKey', 'timeLabel', 'eventType', 'timestampMs'
             ]) &&
             hasOnlyAllowedFields([
               'id', 'trainerId', 'trainerName', 'trainerPhone',
               'dateKey', 'timeLabel', 'eventType', 'timestampMs', 'createdAt'
             ]) &&
             isValidString(data.id, 1, 128) &&
             isValidString(data.trainerId, 1, 128) &&
             isValidString(data.trainerName, 1, 100) &&
             isValidString(data.trainerPhone, 0, 20) &&
             isValidCrowdDateString(data.dateKey) &&
             isValidString(data.timeLabel, 1, 30) &&
             data.eventType is string &&
             data.eventType in ['duty_checkin', 'login'] &&
             data.timestampMs is int &&
             data.timestampMs >= 0 &&
             data.timestampMs <= 4102444800000 &&
             isValidOptionalTimestamp(data, 'createdAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /phone_index/{phone} {
      // Users can read their own phone_index entry; gym owners can read trainer/member entries in their gym.
      allow read: if (hasPhone() && userPhone() == phone) ||
                     (resource != null &&
                      'gymId' in resource.data &&
                      'role' in resource.data &&
                      isGymOwner(resource.data.gymId) &&
                      resource.data.role in ['trainer', 'member']);

      // Owners can create trainer/member phone_index entries for their own gym (or their own owner entry if they own the gym doc);
      // trainers can create member phone_index entries for their own gym when enrolling a new paid member.
      allow create: if isValidPhoneIndex(request.resource.data, phone) &&
                       (
                         (isGymOwner(request.resource.data.gymId) &&
                          (
                            request.resource.data.role in ['trainer', 'member'] ||
                            (request.resource.data.role == 'owner' &&
                             hasPhone() &&
                             userPhone() == phone &&
                             isGymDocOwner(request.resource.data.gymId))
                          )) ||
                         (isGymTrainer(request.resource.data.gymId) &&
                          request.resource.data.role == 'member')
                       );

      // Owners can update trainer/member phone_index entries for their own gym without changing gymId or escalating to owner.
      allow update: if isValidPhoneIndex(request.resource.data, phone) &&
                       areImmutableFieldsUnchanged(['gymId', 'phone']) &&
                       'gymId' in resource.data &&
                       'role' in resource.data &&
                       isGymOwner(resource.data.gymId) &&
                       resource.data.role in ['trainer', 'member'] &&
                       request.resource.data.role in ['trainer', 'member'];

      // Owners can delete trainer/member phone_index entries for their own gym.
      allow delete: if 'gymId' in resource.data &&
                       'role' in resource.data &&
                       isGymOwner(resource.data.gymId) &&
                       resource.data.role in ['trainer', 'member'];
    }

    match /pending_requests/{phone} {
      // Only the verified phone owner can read their pending trainer request status.
      allow read: if hasPhone() && userPhone() == phone;

      // Only the verified phone owner can create or update their own pending request.
      allow create, update: if hasPhone() &&
                               userPhone() == phone &&
                               isValidPendingRequest(request.resource.data, phone) &&
                               request.resource.data.uid == request.auth.uid;

      // The verified phone owner or the target gym's owner can delete the pending request.
      allow delete: if (hasPhone() && userPhone() == phone) ||
                       ('gymId' in resource.data && isGymOwner(resource.data.gymId));
    }

    match /gyms/{gymId} {
      // Any authenticated user belonging to this gym tenant can read its details.
      allow read: if isUserOfGym(gymId);

      // Authenticated user creating a gym must set themselves as ownerUid.
      allow create: if isAuthenticated() &&
                       isValidGym(request.resource.data) &&
                       request.resource.data.ownerUid == request.auth.uid;

      // Owners can update gym fees/settings; trainers can update activeCrowd,
      // crowdDate, and hourlyCheckIns; members can increment/decrement activeCrowd
      // by 1 on the same day or roll over to 1 on a strictly forward new crowdDate.
      allow update: if isValidGym(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'ownerUid', 'createdAt']) &&
                       (
                         (isAuthenticated() &&
                          'ownerUid' in resource.data &&
                          resource.data.ownerUid == request.auth.uid) ||
                         isGymOwner(gymId) ||
                         (isGymTrainer(gymId) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCrowd', 'crowdDate', 'hourlyCheckIns']) &&
                          (!('crowdDate' in resource.data) || ('crowdDate' in request.resource.data)) &&
                          (!('hourlyCheckIns' in resource.data) || ('hourlyCheckIns' in request.resource.data))) ||
                         (isGymMember(gymId) &&
                          isValidMemberCrowdUpdate())
                       );

      allow delete: if (isAuthenticated() &&
                        'ownerUid' in resource.data &&
                        resource.data.ownerUid == request.auth.uid) ||
                       isGymOwner(gymId);

      // Trainers subcollection
      match /trainers/{trainerId} {
        allow read: if isStaffOfGym(gymId);

        allow create: if isGymOwner(gymId) && isValidTrainer(request.resource.data);

        // Owners can update all trainer fields; trainers can only update their own isOnDuty and morningCheckInTime.
        allow update: if isValidTrainer(request.resource.data) &&
                         areImmutableFieldsUnchanged(['id']) &&
                         (
                           isGymOwner(gymId) ||
                           (isGymTrainer(gymId) &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnDuty', 'morningCheckInTime']) &&
                            (('phone' in resource.data && hasPhone() && resource.data.phone == userPhone()) ||
                             trainerId == request.auth.uid))
                         );

        allow delete: if isGymOwner(gymId);
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if isStaffOfGym(gymId) ||
                       (isGymMember(gymId) && hasPhone() && resource.data.phone == userPhone());

        allow create: if isStaffOfGym(gymId) && isValidMember(request.resource.data);

        // Staff can update member records; a gym member can update only isInFloor and floorCheckInTime on their own member document.
        allow update: if (isStaffOfGym(gymId) &&
                          isValidMember(request.resource.data) &&
                          areImmutableFieldsUnchanged(['id', 'createdAt'])) ||
                         (isGymMember(gymId) &&
                          hasPhone() &&
                          ('phone' in resource.data) &&
                          resource.data.phone == userPhone() &&
                          isValidMember(request.resource.data) &&
                          areImmutableFieldsUnchanged(['id', 'createdAt']) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isInFloor', 'floorCheckInTime']));

        allow delete: if isGymOwner(gymId);
      }

      // Walk-in Enquiries subcollection
      match /enquiries/{enquiryId} {
        allow read: if isStaffOfGym(gymId);

        allow create: if isStaffOfGym(gymId) && isValidEnquiry(request.resource.data);

        allow update: if isStaffOfGym(gymId) &&
                         isValidEnquiry(request.resource.data) &&
                         areImmutableFieldsUnchanged(['id', 'createdAt']);

        allow delete: if isGymOwner(gymId);
      }

      // Meals subcollection
      match /meals/{mealId} {
        allow read: if isStaffOfGym(gymId) ||
                       (isGymMember(gymId) && hasPhone() && ('memberPhone' in resource.data) && resource.data.memberPhone == userPhone());

        allow create: if isValidMeal(request.resource.data) &&
                         (
                           isStaffOfGym(gymId) ||
                           (isGymMember(gymId) &&
                            hasPhone() &&
                            ('memberPhone' in request.resource.data) &&
                            request.resource.data.memberPhone == userPhone() &&
                            request.resource.data.trainerFeedback == '')
                         );

        // Only owners and trainers can update trainerFeedback.
        allow update: if isStaffOfGym(gymId) &&
                         isValidMeal(request.resource.data) &&
                         areImmutableFieldsUnchanged(['id', 'memberPhone']) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainerFeedback']);

        allow delete: if isGymOwner(gymId);
      }

      // Machines subcollection
      match /machines/{machineId} {
        allow read: if isUserOfGym(gymId);

        allow create: if isStaffOfGym(gymId) && isValidMachine(request.resource.data);

        allow update: if isStaffOfGym(gymId) &&
                         isValidMachine(request.resource.data) &&
                         areImmutableFieldsUnchanged(['code']);

        allow delete: if isGymOwner(gymId);
      }

      // Staff Invite QR subcollection
      match /invites/{inviteCode} {
        // Any authenticated user can read an invite (e.g. a verified trainer scanning the QR before joining).
        allow read: if isAuthenticated();

        allow create: if isGymOwner(gymId) &&
                         isValidInvite(request.resource.data, gymId) &&
                         request.resource.data.createdByUid == request.auth.uid;

        allow update: if isGymOwner(gymId) &&
                         isValidInvite(request.resource.data, gymId) &&
                         areImmutableFieldsUnchanged(['code', 'gymId', 'createdByUid', 'createdAt']);

        allow delete: if isGymOwner(gymId);
      }

      // Missing members radar subcollection
      match /missing/{missingId} {
        allow read: if isStaffOfGym(gymId);

        allow create: if isStaffOfGym(gymId) && isValidMissingMember(request.resource.data);

        allow update: if isStaffOfGym(gymId) && isValidMissingMember(request.resource.data);

        allow delete: if isGymOwner(gymId);
      }

      // Owner-Approved Trainer Join Requests subcollection
      match /trainer_requests/{requestId} {
        allow read: if isGymOwner(gymId) ||
                       (isAuthenticated() && requestId == request.auth.uid) ||
                       (resource != null && hasPhone() && 'phone' in resource.data && resource.data.phone == userPhone());

        allow create: if hasPhone() &&
                         isValidTrainerRequest(request.resource.data) &&
                         request.resource.data.phone == userPhone() &&
                         request.resource.data.uid == request.auth.uid &&
                         request.resource.data.status == 'pending' &&
                         hasActiveInvite(gymId, request.resource.data.inviteCode);

        allow delete: if isGymOwner(gymId) ||
                         (hasPhone() && 'phone' in resource.data && resource.data.phone == userPhone());
      }

      // Removed trainers & members audit logs subcollection
      match /removed_logs/{logId} {
        allow read: if isGymOwner(gymId);

        allow create: if isGymOwner(gymId) && isValidRemovedLog(request.resource.data);

        allow delete: if isGymOwner(gymId);
      }

      // Append-only trainer login & duty check-in attendance logs subcollection
      match /trainer_attendance/{logId} {
        allow read: if isGymOwner(gymId) ||
                       (isGymTrainer(gymId) &&
                        hasPhone() &&
                        'trainerPhone' in resource.data &&
                        resource.data.trainerPhone == userPhone());

        allow create: if isValidTrainerAttendance(request.resource.data) &&
                         (
                           isGymOwner(gymId) ||
                           (isGymTrainer(gymId) &&
                            hasPhone() &&
                            request.resource.data.trainerPhone == userPhone())
                         );

        allow update: if false;

        allow delete: if isGymOwner(gymId);
      }
    }

    match /app_config/{docId} {
      // Any authenticated user can read runtime app config (e.g. app_config/ai for rotating Gemini API keys).
      allow read: if isSignedIn();

      // Only Firebase Console / Admin SDK can write app_config.
      allow write: if false;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
